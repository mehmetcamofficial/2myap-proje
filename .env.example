# Backend environment variables (api-server)
# DO NOT commit actual values.

# Required
DATABASE_URL=postgresql://user:password@host:5432/dbname
JWT_SECRET=your-secure-random-secret-here
PORT=3000

# Required for seed
ADMIN_EMAIL=admin@2myapi.com
ADMIN_INITIAL_PASSWORD=change-this-password

# CORS
FRONTEND_ORIGIN=https://2myapimarket.vercel.app

# Optional
ADMIN_NAME=Admin
NODE_ENV=production
LOG_LEVEL=info
